<!-- BOOKING POLICIES (icon grid) -->
<section id="policies">
  <p class="eyebrow reveal">Read Before Booking</p>
  <h2 class="title reveal">Booking Policies</h2>
  <p class="lede reveal">Please read fully before requesting an appointment — this keeps things fair and running smoothly for every girl on the books.</p>
  <div class="icon-grid">
    <div class="icon-card reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/><path d="m9.5 15.5 5 5m0-5-5 5"/></svg>
      <h4>Cancellation</h4>
      <p>A 24-hour notice is required prior to cancelling or rescheduling an appointment.</p>
    </div>
    <div class="icon-card reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></svg>
      <h4>Deposit &amp; Payment</h4>
      <p>A $15 non-refundable deposit secures every booking. Cash, Zelle, and card accepted at appointment.</p>
    </div>
    <div class="icon-card reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 15h.01M12 15h.01M16 15h.01"/></svg>
      <h4>Appointments</h4>
      <p>When booking a fill, please be sure you have at least 50% of your lashes — less will be considered a new set.</p>
    </div>
    <div class="icon-card reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
      <h4>Late Policy</h4>
      <p>Please arrive on time. A 15 minute grace period is given, after which your appointment and deposit will be forfeited.</p>
    </div>
  </div>
</section>

<!-- IMPORTANT -->
<section id="important">
  <div class="important-wrap reveal">
    <div class="important-title">
      <span class="bang">!</span>
      <h2>Important</h2>
    </div>
    <div class="important-grid">
      <div>
        <h4>Remove All Makeup</h4>
        <p>Please arrive with clean lashes and no eye makeup. Makeup can affect retention and may reduce your lash time.</p>
      </div>
      <div>
        <h4>Arrive On Time</h4>
        <p>Please be on time to avoid cutting into your lash time. After 15 minutes, your appointment may be cancelled.</p>
      </div>
      <div>
        <h4>Avoid Caffeine</h4>
        <p>Skip the coffee before your appointment — caffeine can make your eyes flutter and make lashing harder.</p>
      </div>
      <div>
        <h4>Dress Comfortably</h4>
        <p>You'll be laying down for a while, so wear something cozy to relax in.</p>
      </div>
    </div>
  </div>
</section>

<!-- AFTERCARE -->
<section id="aftercare">
  <p class="eyebrow reveal">Care Guide</p>
  <h2 class="title reveal">Before &amp; After Your Appointment</h2>
  <p class="lede reveal">Follow this and your set will thank you — longer retention, healthier natural lashes, happier RiRi.</p>
  <div class="toggle-card open reveal">
    <div class="toggle-head" style="cursor:default;"><h3>Routine Care</h3></div>
    <div class="toggle-body" style="max-height:900px; padding-bottom:26px;">
      <div class="care-tabs">
        <button class="care-tab-btn active" onclick="showCare(this,'before')">Before You Come In</button>
        <button class="care-tab-btn" onclick="showCare(this,'after')">After Your Service</button>
      </div>
      <div class="care-panel active" data-panel="before">
        <h4>Come in with:</h4>
        <ul>
          <li>Clean lashes — no mascara, oil, or makeup residue.</li>
          <li>Freshly showered if possible — oily lids affect adhesive bond.</li>
          <li>No caffeine right before your appointment (it makes your eyes flutter more!).</li>
          <li>Contacts out or in a case handy if you wear them.</li>
        </ul>
      </div>
      <div class="care-panel" data-panel="after">
        <h4>For the first 24–48 hours:</h4>
        <ul>
          <li>Avoid water, steam, and sweat on the lash line.</li>
          <li>No mascara, oil-based products, or makeup remover near the eyes.</li>
          <li>Sleep on your back or use a lash pillow to protect the set.</li>
        </ul>
        <h4>Ongoing:</h4>
        <ul>
          <li>Cleanse lashes daily with a lash-safe cleanser to extend retention.</li>
          <li>Brush through gently every morning.</li>
          <li>Book your fill at 2–3 weeks max for the healthiest natural lash underneath.</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Foreign fills as its own toggle -->
  <div class="toggle-card reveal" onclick="toggleCard(this)">
    <div class="toggle-head"><h3>Foreign Fills</h3><span class="plus">+</span></div>
    <div class="toggle-body">
      <ul>
        <li>Foreign fills (sets started by another lash tech) are accepted.</li>
        <li>When booking, please provide: your lash <strong>sizes/mm</strong>, the <strong>style</strong> you'd like, and clear <strong>photos or video</strong> of your current set.</li>
        <li>Let me know the <strong>diameter</strong> your previous lash tech used, and whether it's <strong>hybrid or classic</strong>.</li>
        <li>Foreign fills are priced higher than a regular fill since it isn't my original work — final quote is confirmed after photos are reviewed.</li>
      </ul>
    </div>
  </div>
</section>

<!-- TENSION TRACKER -->
<section id="tracker">
  <p class="eyebrow reveal">Little Check-In</p>
  <h2 class="title reveal">How Long Has It Been?</h2>
  <p class="lede reveal">Drop the date of your last set below and I'll tell you exactly where your "tension rate" is sitting.</p>
  <div class="tracker-box reveal">
    <label for="lastFillDate" class="eyebrow" style="color:var(--lilac);">Last Fill / Set Date</label><br>
    <input type="date" id="lastFillDate" onchange="checkTension()">
    <div class="tension-bar"><div class="tension-fill" id="tensionFill"></div></div>
    <p id="trackerResult"></p>
  </div>
</section>

<!-- REVIEWS -->
<section id="reviews">
  <p class="eyebrow reveal">Client Love</p>

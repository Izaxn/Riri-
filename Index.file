<!-- BOOKING -->
<section id="booking">
  <div class="booking-box reveal">
    <p class="eyebrow" style="color:var(--gold);">Demo Booking</p>
    <h2 class="title">Reserve Your Seat</h2>
    <p class="lede">This is a demo request form — fill in your info below and I'll be in touch to confirm your appointment.</p>
    <form class="booking-form" onsubmit="return submitBooking(event)">
      <div class="field"><label for="bName">Your Name</label><input type="text" id="bName" placeholder="Full name" required></div>
      <div class="field"><label for="bPhone">Phone Number</label><input type="tel" id="bPhone" placeholder="(214) 000-0000" required></div>
      <div class="field"><label for="bDate">Preferred Date</label><input type="date" id="bDate" required></div>
      <div class="field"><label for="bTime">Preferred Time</label><input type="time" id="bTime" required></div>
      <div class="field full">
        <label for="bService">Service</label>
        <select id="bService" required>
          <option value="">Select a service...</option>
          <option>Classic Full Set</option>
          <option>Hybrid Full Set</option>
          <option>Wet Set</option>
          <option>Light Volume Full Set</option>
          <option>Volume Full Set</option>
          <option>Mega Volume Full Set</option>
          <option>Fill</option>
          <option>Foreign Fill</option>
          <option>House Call</option>
        </select>
      </div>
      <button type="submit" class="btn btn-book full">Send Booking Request</button>
      <p id="bookingMsg" class="full"></p>
    </form>
  </div>
</section>

<!-- THANK YOU -->
<div class="thankyou reveal">
  <div class="thankyou-inner">
    <span class="script">Thank You 💜</span>
    <p class="ty-body">If you prefer not to be featured in posts, kindly let me know — thank you!</p>
    <p class="ty-handle">📸 @riri__lashlundry</p>
    <div class="hashtag-row">
      <span>#ririlashlaundry</span>
      <span>#lashkissed</span>
      <span>#duncanvillelashes</span>
      <span>#freshset</span>
    </div>
    <span class="thankyou-note">Pick your service &amp; add extras above</span>
  </div>
</div>

<footer>
  <span class="script">Ririlashlaundry</span>
  <p class="foot-sub">Duncanville, Texas &middot; Lash &amp; Nail Studio &middot; By Appointment Only</p>
  <div class="foot-links">
    <a href="#booking">Book Now</a>
    <a href="#policies">Policies</a>
    <a href="#gallery">Portfolio</a>
  </div>
</footer>

<script>
  // ---------- Decorative bows / hearts / pearls / sparkles background ----------
  const decoLayer = document.getElementById('decoLayer');
  const bowSVG = (x,y,scale,rot,color) => `
<svg viewBox="0 0 100 60" width="${64*scale}" height="${38*scale}" style="left:${x}%; top:${y}%; transform:rotate(${rot}deg);">
<path d="M50 30 C40 5, 5 5, 5 30 C5 55, 40 55, 50 30 C60 55, 95 55, 95 30 C95 5, 60 5, 50 30 Z" fill="none" stroke="${color}" stroke-width="3"/>
<circle cx="50" cy="30" r="6" fill="${color}"/>
</svg>`;
  const heartSVG = (x,y,scale,rot,color) => `
<svg viewBox="0 0 100 90" width="${40*scale}" height="${36*scale}" style="left:${x}%; top:${y}%; transform:rotate(${rot}deg);">
<path d="M50 85 C10 55 5 25 25 12 C40 3 50 15 50 25 C50 15 60 3 75 12 C95 25 90 55 50 85 Z" fill="${color}"/>
</svg>`;
  const pearlSVG = (x,y,scale,rot,color) => `
<svg viewBox="0 0 100 100" width="${22*scale}" height="${22*scale}" style="left:${x}%; top:${y}%; transform:rotate(${rot}deg);">
<circle cx="50" cy="50" r="42" fill="${color}"/>
</svg>`;
  const sparkleSVG = (x,y,scale,rot,color) => `
<svg viewBox="0 0 100 100" width="${26*scale}" height="${26*scale}" style="left:${x}%; top:${y}%; transform:rotate(${rot}deg);">
<path d="M50 0 C52 35 65 48 100 50 C65 52 52 65 50 100 C48 65 35 52 0 50 C35 48 48 35 50 0 Z" fill="${color}"/>
</svg>`;
  const decoColors = ['#b478ff','#e9c86a','#8b5cf6','#d9c2ff'];
  const decoShapes = [bowSVG, heartSVG, pearlSVG, sparkleSVG];
  let decoHTML = '';
  const spots = [[4,8],[90,6],[8,40],[93,36],[5,76],[88,70],[46,3],[52,92],[22,58],[72,14],[15,90],[80,48],[35,20],[62,66]];
  spots.forEach((s,i)=>{
    const color = decoColors[i % decoColors.length];
    const shape = decoShapes[i % decoShapes.length];
    const scale = 0.7 + Math.random()*0.9;
    const rot = Math.floor(Math.random()*40 - 20);
    decoHTML += shape(s[0], s[1], scale, rot, color);
  });
  decoLayer.innerHTML = decoHTML;

  // ---------- Reveal on scroll ----------
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:0.12});
  revealEls.forEach(el=>io.observe(el));

  // ---------- Toggle policy/foreign-fill cards ----------
  function toggleCard(card){
    const body = card.querySelector('.toggle-body');
    const isOpen = card.classList.contains('open');
    if(!isOpen){
      card.classList.add('open');
      body.style.maxHeight = body.scrollHeight + 'px';
    } else {
      card.classList.remove('open');
      body.style.maxHeight = null;
    }
  }

  // ---------- Aftercare tabs ----------
  function showCare(btn, which){
    document.querySelectorAll('.care-tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.care-panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.querySelector(`.care-panel[data-panel="${which}"]`).classList.add('active');
  }

  // ---------- Tension tracker ----------
  function checkTension(){
    const val = document.getElementById('lastFillDate').value;
    const result = document.getElementById('trackerResult');
    const fill = document.getElementById('tensionFill');
    if(!val){ result.textContent = ''; fill.style.width='0%'; return; }
    const last = new Date(val);
    const today = new Date();
    const days = Math.floor((today - last) / (1000*60*60*24));
    if(days < 0){ result.textContent = "That date hasn't happened yet, silly 💜"; fill.style.width = '0%'; return; }
    let msg, pct;
    if(days <= 7){ msg = `${days} day${days===1?'':'s'} in — fresh and full, enjoy the honeymoon phase 💜`; pct = 15; }
    else if(days <= 14){ msg = `${days} days in — still looking full, you've got a little time yet.`; pct = 40; }
    else if(days <= 21){ msg = `${days} days in — prime fill window, book now to stay full ✧`; pct = 68; }
    else if(days <= 28){ msg = `${days} days in — tension is dropping, a fill is overdue, girl.`; pct = 88; }
    else { msg = `${days} days in — that's past fill range, you'll likely need a full new set at this point.`; pct = 100; }
    result.textContent = msg;
    fill.style.width = pct + '%';
  }

  // ---------- Booking form (demo) ----------
  function submitBooking(e){
    e.preventDefault();
    const name = document.getElementById('bName').value;
    const service = document.getElementById('bService').value;
    const date = document.getElementById('bDate').value;
    const time = document.getElementById('bTime').value;
    const msg = document.getElementById('bookingMsg');
    msg.style.display = 'block';
    msg.textContent = `✧ Demo only — thank you ${name}! Your request for "${service}" on ${date} at ${time} has been noted. RiRi will confirm your $15 deposit link shortly. ✧`;
    return false;
  }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ririlashlaundry | Duncanville, TX Lash &amp; Nail Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playball&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#0a0713;
    --void-2:#150c25;
    --purple-deep:#2a1247;
    --purple:#6d3fc7;
    --purple-mid:#8b5cf6;
    --lilac:#c9a8ff;
    --lilac-light:#efe4ff;
    --neon:#b478ff;
    --neon-glow:rgba(180,120,255,.55);
    --gold:#e9c86a;
    --card:#160e26;
    --card-line:#3a1f5c;
    --ink:#f3ecff;
    --muted:#b3a0d6;
    --shadow: 0 25px 60px -25px rgba(140,70,220,.55);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Poppins', sans-serif;
    background:var(--void);
    color:var(--ink);
    overflow-x:hidden;
    position:relative;
  }
  .script{font-family:'Playball', cursive;}
  .serif{font-family:'Playfair Display', serif;}
  ::selection{background:var(--purple-mid); color:#fff;}

  /* ---------- Deco layer (twinkles) ---------- */
  .deco-layer{position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden;}
  .deco-layer svg{position:absolute; opacity:.35; filter:drop-shadow(0 0 6px var(--neon-glow));}

  /* ---------- Nav ---------- */
  nav{
    position:sticky; top:0; z-index:50;
    display:flex; align-items:center; justify-content:center;
    gap:clamp(10px,2vw,26px);
    padding:16px 12px;
    background:rgba(10,7,19,0.82);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--card-line);
    flex-wrap:wrap;
  }
  nav a{
    text-decoration:none; color:var(--lilac);
    font-size:.7rem; letter-spacing:.16em; text-transform:uppercase;
    font-weight:500; position:relative; padding-bottom:3px;
  }
  nav a::after{content:''; position:absolute; left:0; bottom:0; width:0; height:1px; background:var(--gold); transition:width .3s ease;}
  nav a:hover::after{width:100%;}
  nav a:hover{color:#fff;}

  /* ---------- Hero ---------- */
  .hero{
    position:relative; z-index:1;
    min-height:100vh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:70px 20px 90px;
    background:
      radial-gradient(circle at 18% 18%, rgba(180,120,255,.30), transparent 45%),
      radial-gradient(circle at 85% 78%, rgba(120,60,200,.28), transparent 42%),
      linear-gradient(180deg, var(--void) 0%, var(--void-2) 100%);
  }
  .pin{
    font-size:.68rem; letter-spacing:.3em; text-transform:uppercase; color:var(--gold);
    margin-bottom:18px; display:flex; align-items:center; gap:8px; justify-content:center;
  }
  .profile-ring{
    width:190px; height:190px; border-radius:50%; padding:6px;
    background: conic-gradient(from 180deg, var(--gold), var(--neon), var(--purple), var(--gold));
    box-shadow:var(--shadow);
    animation: floatIn 1.1s cubic-bezier(.2,.9,.25,1) both;
  }
  .profile-ring img{width:100%; height:100%; border-radius:50%; object-fit:cover; border:4px solid var(--void); display:block;}
  @keyframes floatIn{from{opacity:0; transform:translateY(30px) scale(.9);} to{opacity:1; transform:translateY(0) scale(1);}}
  @keyframes glowPulse{
    0%,100%{text-shadow:0 0 18px var(--neon-glow), 0 0 40px rgba(180,120,255,.35), 0 0 2px #fff;}
    50%{text-shadow:0 0 30px var(--neon-glow), 0 0 60px rgba(180,120,255,.55), 0 0 4px #fff;}
  }
  .hero h1{
    font-family:'Playball', cursive;
    font-size:clamp(3.4rem, 10vw, 6.4rem);
    color:#e9d9ff;
    margin-top:20px; line-height:1;
    animation: floatIn 1.1s .15s cubic-bezier(.2,.9,.25,1) both, glowPulse 3.5s ease-in-out infinite;
  }
  .hero .tagline{
    margin-top:12px; letter-spacing:.34em; text-transform:uppercase; font-size:.72rem;
    color:var(--lilac); opacity:.9;
    animation: floatIn 1.1s .3s cubic-bezier(.2,.9,.25,1) both;
  }
  .hero .sub{
    max-width:540px; margin:24px auto 0;
    font-family:'Playfair Display', serif; font-size:1.2rem; font-style:italic; color:var(--muted);
    animation: floatIn 1.1s .45s cubic-bezier(.2,.9,.25,1) both;
  }
  .cta-row{margin-top:36px; display:flex; gap:16px; flex-wrap:wrap; justify-content:center; animation: floatIn 1.1s .6s cubic-bezier(.2,.9,.25,1) both;}
  .btn{
    display:inline-block; padding:14px 34px; border-radius:999px; font-size:.76rem;
    letter-spacing:.18em; text-transform:uppercase; text-decoration:none; cursor:pointer;
    border:1px solid transparent; transition:transform .25s ease, box-shadow .25s ease;
    font-family:'Poppins', sans-serif; font-weight:600;
  }
  .btn-fill{background:linear-gradient(120deg, var(--purple), var(--purple-mid)); color:#fff; box-shadow:0 14px 30px -10px rgba(140,70,220,.65);}
  .btn-fill:hover{transform:translateY(-3px); box-shadow:0 18px 34px -10px rgba(140,70,220,.8);}
  .btn-outline{border-color:var(--lilac); color:var(--lilac); background:transparent;}
  .btn-outline:hover{background:var(--lilac); color:var(--void); transform:translateY(-3px);}

  /* ---------- Sections ---------- */
  section{position:relative; z-index:1; padding:100px 20px; max-width:1080px; margin:0 auto;}
  .eyebrow{text-align:center; letter-spacing:.35em; text-transform:uppercase; font-size:.66rem; color:var(--gold); font-weight:600; margin-bottom:10px;}
  h2.title{
    text-align:center; font-family:'Playball', cursive; font-size:clamp(2.6rem,6.5vw,3.8rem);
    color:#e9d9ff; margin-bottom:8px; text-shadow:0 0 24px var(--neon-glow);
  }
  .lede{text-align:center; max-width:620px; margin:0 auto 50px; font-family:'Playfair Display', serif; font-size:1.12rem; color:var(--muted);}

  /* ---------- About ---------- */
  .about-wrap{display:grid; grid-template-columns:1fr 1.2fr; gap:50px; align-items:center;}
  .about-frame{position:relative; aspect-ratio:4/5; border-radius:6px 60px 6px 60px; overflow:hidden; box-shadow:var(--shadow); border:3px solid var(--card-line);}
  .about-frame img{width:100%; height:100%; object-fit:cover;}
  .about-text p{font-family:'Playfair Display', serif; font-size:1.16rem; line-height:1.75; margin-bottom:16px; color:var(--ink);}
  .about-text strong{color:var(--lilac);}
  .stat-row{display:flex; gap:30px; margin-top:26px; flex-wrap:wrap;}
  .stat-row div{text-align:left;}
  .stat-num{font-family:'Playfair Display',serif; font-size:2rem; color:var(--lilac); font-weight:700;}
  .stat-label{font-size:.66rem; letter-spacing:.14em; text-transform:uppercase; opacity:.75;}
  @media (max-width:760px){.about-wrap{grid-template-columns:1fr;}}

  /* ---------- Gallery ---------- */
  .gallery-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:16px;}
  .gallery-item{position:relative; border-radius:16px; overflow:hidden; aspect-ratio:1/1.1; box-shadow:0 16px 34px -16px rgba(140,70,220,.5); cursor:pointer; border:1px solid var(--card-line);}
  .gallery-item:nth-child(2){transform:translateY(18px);}
  .gallery-item:nth-child(4){transform:translateY(-14px);}
  .gallery-item img{width:100%; height:100%; object-fit:cover; transition:transform .6s ease, filter .6s ease;}
  .gallery-item:hover img{transform:scale(1.08); filter:saturate(1.15);}
  .gallery-item::after{content:''; position:absolute; inset:0; background:linear-gradient(180deg, transparent 55%, rgba(30,10,55,.85) 100%); opacity:0; transition:opacity .4s ease;}
  .gallery-item:hover::after{opacity:1;}
  .gallery-item span{position:absolute; bottom:14px; left:14px; color:#fff; font-family:'Playball', cursive; font-size:1.6rem; opacity:0; transform:translateY(10px); transition:all .4s ease; z-index:2;}
  .gallery-item:hover span{opacity:1; transform:translateY(0);}
  .gallery-item.placeholder{
    display:flex; align-items:center; justify-content:center;
    background:radial-gradient(circle at 30% 20%, rgba(180,120,255,.28), transparent 55%),
               linear-gradient(150deg, var(--purple-deep), var(--void-2));
  }
  .gallery-item.placeholder .ph-mark{color:var(--lilac); opacity:.55; filter:drop-shadow(0 0 10px var(--neon-glow));}
  .gallery-item.placeholder span{opacity:1; transform:none; position:absolute; bottom:14px; left:14px; font-size:1.4rem;}

  /* ---------- Pricing ---------- */
  .price-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:24px; margin-bottom:34px;}
  .price-card{background:var(--card); border:1px solid var(--card-line); border-radius:18px; padding:30px 26px; box-shadow:var(--shadow); transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease; position:relative; overflow:hidden;}
  .price-card:hover{transform:translateY(-6px); border-color:var(--neon);}
  .price-card::before{content:''; position:absolute; top:-40px; right:-40px; width:120px; height:120px; background:radial-gradient(circle, rgba(180,120,255,.25), transparent 70%);}
  .price-card h3{font-family:'Playfair Display', serif; font-size:1.5rem; color:var(--lilac); margin-bottom:14px; letter-spacing:.02em;}
  .price-row{display:flex; justify-content:space-between; font-size:.92rem; padding:8px 0; border-bottom:1px dashed var(--card-line); color:var(--ink);}
  .price-row:last-child{border-bottom:none;}
  .price-row .amt{color:var(--gold); font-weight:600;}
  .note-strip{display:flex; gap:20px; flex-wrap:wrap; justify-content:center; background:linear-gradient(120deg, var(--purple-deep), var(--void-2)); border:1px dashed var(--gold); border-radius:16px; padding:22px; text-align:center;}
  .note-strip div{font-size:.85rem; color:var(--muted);}
  .note-strip b{display:block; font-family:'Playfair Display', serif; font-size:1.3rem; color:var(--lilac);}

  /* ---------- Icon grid (Booking Policies) ---------- */
  .icon-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(220px,1fr)); gap:20px;}
  .icon-card{background:var(--card); border:1px solid var(--card-line); border-radius:18px; padding:28px 22px; text-align:center; box-shadow:var(--shadow);}
  .icon-card svg{width:38px; height:38px; margin-bottom:14px; stroke:var(--neon); filter:drop-shadow(0 0 8px var(--neon-glow));}
  .icon-card h4{font-family:'Playball', cursive; font-size:1.6rem; color:#e9d9ff; margin-bottom:10px;}
  .icon-card p{font-size:.86rem; line-height:1.6; color:var(--muted);}

  /* ---------- Toggle Cards ---------- */
  .toggle-card{background:var(--card); border:1px solid var(--card-line); border-radius:18px; margin-bottom:18px; box-shadow:var(--shadow); overflow:hidden;}
  .toggle-head{display:flex; align-items:center; justify-content:space-between; padding:22px 26px; cursor:pointer; user-select:none;}
  .toggle-head h3{font-family:'Playfair Display', serif; font-size:1.4rem; color:var(--lilac); display:flex; align-items:center; gap:12px;}
  .toggle-head .plus{font-size:1.4rem; color:var(--gold); transition:transform .35s ease;}
  .toggle-card.open .plus{transform:rotate(135deg);}
  .toggle-body{max-height:0; overflow:hidden; transition:max-height .45s ease; padding:0 26px;}
  .toggle-card.open .toggle-body{padding-bottom:26px;}
  .toggle-body ul{padding-left:20px; margin-top:6px;}
  .toggle-body li{margin-bottom:10px; font-size:.94rem; line-height:1.55; color:var(--ink);}
  .toggle-body h4{color:var(--lilac); margin:14px 0 6px; font-family:'Playfair Display', serif; font-size:1.1rem;}
  .care-tabs{display:flex; gap:10px; margin-bottom:10px; flex-wrap:wrap;}
  .care-tab-btn{border:1px solid var(--card-line); background:var(--void-2); color:var(--lilac); padding:8px 16px; border-radius:999px; font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; cursor:pointer;}
  .care-tab-btn.active{background:var(--purple-mid); color:#fff; border-color:var(--purple-mid);}
  .care-panel{display:none;}
  .care-panel.active{display:block;}

  /* ---------- Tracker ---------- */
  .tracker-box{background:var(--card); border:1px solid var(--card-line); border-radius:22px; padding:40px; text-align:center; box-shadow:var(--shadow);}
  .tracker-box input[type=date]{font-family:'Poppins', sans-serif; padding:12px 18px; border-radius:999px; border:1px solid var(--purple-mid); background:var(--void-2); color:var(--ink); font-size:.9rem; margin-top:14px; color-scheme:dark;}
  #trackerResult{margin-top:26px; font-family:'Playfair Display', serif; font-size:1.25rem; color:var(--lilac); min-height:1.6em;}
  .tension-bar{width:100%; max-width:420px; margin:20px auto 0; height:10px; border-radius:999px; background:var(--void-2); overflow:hidden; border:1px solid var(--card-line);}
  .tension-fill{height:100%; width:0%; background:linear-gradient(90deg, var(--gold), var(--neon)); transition:width .8s ease;}

  /* ---------- Reviews ---------- */
  .review-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(260px,1fr)); gap:22px;}
  .review-card{background:var(--card); border:1px solid var(--card-line); border-radius:18px; padding:26px; box-shadow:var(--shadow);}
  .stars{color:var(--gold); letter-spacing:2px; margin-bottom:10px;}
  .review-card p{font-family:'Playfair Display', serif; font-style:italic; font-size:1.03rem; line-height:1.6; margin-bottom:14px; color:var(--ink);}
  .review-name{font-size:.76rem; letter-spacing:.1em; text-transform:uppercase; color:var(--lilac); font-weight:600;}

  /* ---------- Important info grid ---------- */
  .important-wrap{background:var(--card); border:1px solid var(--card-line); border-radius:22px; padding:44px clamp(20px,5vw,50px); box-shadow:var(--shadow);}
  .important-title{display:flex; align-items:center; justify-content:center; gap:14px; margin-bottom:36px;}
  .important-title .bang{width:34px; height:34px; border-radius:50%; border:2px solid var(--gold); display:flex; align-items:center; justify-content:center; font-family:'Playfair Display',serif; font-weight:700; color:var(--gold); flex-shrink:0;}
  .important-title h2{font-family:'Playball', cursive; font-size:clamp(2.4rem,7vw,3.6rem); color:#e9d9ff; text-shadow:0 0 24px var(--neon-glow); letter-spacing:.02em;}
  .important-grid{display:grid; grid-template-columns:repeat(auto-fit, minmax(240px,1fr)); gap:30px 40px;}
  .important-grid div h4{font-size:.95rem; letter-spacing:.08em; text-transform:uppercase; color:var(--lilac); margin-bottom:8px; border-bottom:1px solid var(--card-line); padding-bottom:8px;}
  .important-grid div p{font-size:.9rem; line-height:1.6; color:var(--muted);}

  /* ---------- Booking ---------- */
  .booking-box{background:linear-gradient(160deg, var(--purple-deep), var(--purple)); border-radius:26px; padding:50px clamp(20px,5vw,60px); color:#fff; box-shadow:0 30px 65px -25px rgba(140,70,220,.7); position:relative; overflow:hidden;}
  .booking-box::before{content:''; position:absolute; inset:0; background:radial-gradient(circle at 90% 10%, rgba(255,255,255,.12), transparent 40%);}
  .booking-box h2.title{color:#fff; text-shadow:0 0 20px rgba(255,255,255,.4);}
  .booking-box .lede{color:var(--lilac-light); opacity:.9;}
  form.booking-form{position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:20px;}
  form.booking-form .full{grid-column:1/-1;}
  .field label{display:block; font-size:.68rem; letter-spacing:.16em; text-transform:uppercase; margin-bottom:6px; opacity:.9;}
  .field input, .field select{width:100%; padding:13px 16px; border-radius:10px; border:1px solid rgba(255,255,255,.4); background:rgba(255,255,255,.12); color:#fff; font-family:'Poppins', sans-serif; font-size:.92rem;}
  .field input::placeholder{color:rgba(255,255,255,.65);}
  .field input:focus, .field select:focus{outline:2px solid var(--gold); background:rgba(255,255,255,.2);}
  .field select option{color:#111;}
  .booking-form .btn{margin-top:8px; border:none; cursor:pointer;}
  .btn-book{background:#fff; color:var(--purple-deep); font-weight:700;}
  .btn-book:hover{transform:translateY(-3px); box-shadow:0 16px 26px -12px rgba(0,0,0,.45);}
  #bookingMsg{grid-column:1/-1; margin-top:6px; font-family:'Playfair Display', serif; font-size:1.05rem; font-style:italic; display:none;}
  @media (max-width:620px){form.booking-form{grid-template-columns:1fr;}}

  /* ---------- Thank you strip ---------- */
  .thankyou{
    position:relative; z-index:1; max-width:1080px; margin:0 auto 0; padding:0 20px 30px;
  }
  .thankyou-inner{
    background:linear-gradient(120deg, var(--void-2), var(--purple-deep));
    border:1px solid var(--card-line); border-radius:22px; padding:44px clamp(20px,5vw,50px);
    text-align:center; box-shadow:var(--shadow);
  }
  .thankyou-inner .script{font-size:clamp(2.6rem,7vw,3.8rem); color:#e9d9ff; text-shadow:0 0 24px var(--neon-glow); display:block; margin-bottom:16px;}
  .thankyou-inner .ty-body{font-family:'Poppins', sans-serif; font-size:.95rem; font-weight:400; line-height:1.6; color:var(--ink); max-width:440px; margin:0 auto 14px;}
  .thankyou-inner .ty-handle{font-family:'Poppins', sans-serif; font-size:1rem; font-weight:600; letter-spacing:.03em; color:var(--lilac); margin-bottom:18px;}
  .hashtag-row{display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:20px;}
  .hashtag-row span{font-family:'Poppins', sans-serif; font-size:.76rem; font-weight:600; letter-spacing:.02em; color:var(--gold); background:rgba(233,200,106,.1); border:1px solid rgba(233,200,106,.3); border-radius:999px; padding:6px 16px;}
  .thankyou-note{display:inline-block; border:1px solid var(--card-line); border-radius:999px; padding:10px 22px; font-size:.72rem; letter-spacing:.05em; font-family:'Poppins', sans-serif; color:var(--muted); margin:6px;}

  /* ---------- Footer ---------- */
  footer{position:relative; z-index:1; text-align:center; padding:60px 20px 40px; color:var(--lilac);}
  footer .script{font-size:2.4rem; display:block; margin-bottom:10px; text-shadow:0 0 20px var(--neon-glow);}
  footer .foot-sub{font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; opacity:.75;}
  footer .foot-links{margin-top:16px; display:flex; justify-content:center; gap:18px; flex-wrap:wrap;}
  footer .foot-links a{color:var(--lilac); text-decoration:none; font-size:.78rem; letter-spacing:.08em;}
  footer .foot-links a:hover{text-decoration:underline; color:#fff;}

  .reveal{opacity:0; transform:translateY(28px); transition:opacity .8s ease, transform .8s ease;}
  .reveal.in{opacity:1; transform:translateY(0);}
</style>
</head>
<body>
<div class="deco-layer" id="decoLayer"></div>

<nav>
  <a href="#about">About</a>
  <a href="#gallery">My Girls</a>
  <a href="#services">Pricing</a>
  <a href="#policies">Policies</a>
  <a href="#important">Important</a>
  <a href="#aftercare">Lash Care</a>
  <a href="#reviews">Reviews</a>
  <a href="#booking">Book Now</a>
</nav>

<!-- HERO -->
<header class="hero">
  <p class="pin">📍 Located in Duncanville, TX</p>
  <div class="profile-ring">
    <img src="data:image/jpeg;base64," alt="Ririlashlaundry logo">
  </div>
  <h1>Ririlashlaundry</h1>
  <p class="tagline">Lash &amp; Nail Studio · Duncanville, Texas</p>
  <p class="sub">Soft glam sets, wet-look volumes, and press-on perfection — book your fresh set with RiRi.</p>
  <div class="cta-row">
    <a href="#booking" class="btn btn-fill">Book Your Appointment</a>
    <a href="#gallery" class="btn btn-outline">See My Girls</a>
  </div>
</header>

<!-- ABOUT / MEET YOUR TECH -->
<section id="about">
  <p class="eyebrow reveal">The Artist</p>
  <h2 class="title reveal">Meet Your Lash Tech</h2>
  <div class="about-wrap">
    <div class="about-frame reveal">
      <img src="data:image/jpeg;base64," alt="Ririlashlaundry brand mark" style="object-fit:contain; background:radial-gradient(circle, var(--purple-deep), var(--void));">
    </div>
    <div class="about-text reveal">
      <p>Hi love, I'm <strong>RiRi</strong> — a Duncanville-based lash &amp; nail artist who treats every appointment like a full reset, not just a service. My chair is a judgement-free zone: candles lit, playlist on, and your lashes or nails in the hands of someone who actually cares if you leave feeling like the best version of yourself.</p>
      <p>I specialize in <strong>classic, hybrid, volume, and mega volume</strong> lash sets, wet-look styling, foreign fills, and custom press-on nail sets. Every set is mapped to your eye shape first — trend second.</p>
      <p>Booked out weeks in advance for a reason. Come see why the girls keep coming back.</p>
      <div class="stat-row">
        <div><span class="stat-num">3+</span><span class="stat-label">Years Behind The Table</span></div>
        <div><span class="stat-num">500+</span><span class="stat-label">Sets Laid</span></div>
        <div><span class="stat-num">5.0</span><span class="stat-label">Client Rating</span></div>
      </div>
    </div>
  </div>
</section>

<!-- GALLERY -->
<section id="gallery">
  <p class="eyebrow reveal">Portfolio</p>
  <h2 class="title reveal">My Girls</h2>
  <p class="lede reveal">A little peek at the sets that walked out my door looking unbothered, moisturized, and taken care of. <em>(Drop in your real set photos here — these are placeholders.)</em></p>
  <div class="gallery-grid">
    <div class="gallery-item placeholder reveal">
      <div class="ph-mark"><svg viewBox="0 0 100 60" width="70" height="42"><path d="M50 30 C40 5, 5 5, 5 30 C5 55, 40 55, 50 30 C60 55, 95 55, 95 30 C95 5, 60 5, 50 30 Z" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="30" r="6" fill="currentColor"/></svg></div>
      <span>laid ✧</span>
    </div>
    <div class="gallery-item placeholder reveal">
      <div class="ph-mark"><svg viewBox="0 0 100 90" width="60" height="54"><path d="M50 85 C10 55 5 25 25 12 C40 3 50 15 50 25 C50 15 60 3 75 12 C95 25 90 55 50 85 Z" fill="currentColor"/></svg></div>
      <span>fresh ✧</span>
    </div>
    <div class="gallery-item placeholder reveal">
      <div class="ph-mark"><svg viewBox="0 0 100 100" width="56" height="56"><circle cx="30" cy="70" r="16" fill="currentColor" opacity=".9"/><circle cx="65" cy="45" r="22" fill="currentColor" opacity=".7"/><circle cx="78" cy="80" r="9" fill="currentColor" opacity=".85"/></svg></div>
      <span>laundered ✧</span>
    </div>
    <div class="gallery-item placeholder reveal">
      <div class="ph-mark"><svg viewBox="0 0 100 60" width="70" height="42"><path d="M50 30 C40 5, 5 5, 5 30 C5 55, 40 55, 50 30 C60 55, 95 55, 95 30 C95 5, 60 5, 50 30 Z" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="50" cy="30" r="6" fill="currentColor"/></svg></div>
      <span>glam ✧</span>
    </div>
    <div class="gallery-item placeholder reveal">
      <div class="ph-mark"><svg viewBox="0 0 100 90" width="60" height="54"><path d="M50 85 C10 55 5 25 25 12 C40 3 50 15 50 25 C50 15 60 3 75 12 C95 25 90 55 50 85 Z" fill="currentColor"/></svg></div>
      <span>clean ✧</span>
    </div>
  </div>
</section>

<!-- SERVICES / PRICING -->
<section id="services">
  <p class="eyebrow reveal">Investment</p>
  <h2 class="title reveal">Services &amp; Pricing</h2>
  <p class="lede reveal">Every price includes a full consultation, mapping, and aftercare walkthrough. No rushed sets, ever.</p>
  <p class="eyebrow reveal" style="margin-top:10px;">Full Sets</p>
  <div class="price-grid">
    <div class="price-card reveal"><h3>Classic</h3><div class="price-row"><span>Full Set</span><span class="amt">$55</span></div></div>
    <div class="price-card reveal"><h3>Hybrid</h3><div class="price-row"><span>Full Set</span><span class="amt">$60</span></div></div>
    <div class="price-card reveal"><h3>Wet Set</h3><div class="price-row"><span>Full Set</span><span class="amt">$65</span></div></div>
    <div class="price-card reveal"><h3>Light Volume</h3><div class="price-row"><span>Full Set</span><span class="amt">$70</span></div></div>
    <div class="price-card reveal"><h3>Volume</h3><div class="price-row"><span>Full Set</span><span class="amt">$75</span></div></div>
    <div class="price-card reveal"><h3>Mega Volume</h3><div class="price-row"><span>Full Set</span><span class="amt">$85</span></div></div>
  </div>
  <p class="eyebrow reveal" style="margin-top:10px;">Fills</p>
  <div class="price-grid">
    <div class="price-card reveal"><h3>Classic</h3><div class="price-row"><span>1–2 weeks</span><span class="amt">$20</span></div><div class="price-row"><span>2–3 weeks</span><span class="amt">$30</span></div></div>
    <div class="price-card reveal"><h3>Hybrid</h3><div class="price-row"><span>1–2 weeks</span><span class="amt">$35</span></div><div class="price-row"><span>2–3 weeks</span><span class="amt">$40</span></div></div>
    <div class="price-card reveal"><h3>Light Volume</h3><div class="price-row"><span>1–2 weeks</span><span class="amt">$40</span></div><div class="price-row"><span>2–3 weeks</span><span class="amt">$45</span></div></div>
    <div class="price-card reveal"><h3>Volume</h3><div class="price-row"><span>1–2 weeks</span><span class="amt">$50</span></div><div class="price-row"><span>2–3 weeks</span><span class="amt">$55</span></div></div>
    <div class="price-card reveal"><h3>Mega Volume</h3><div class="price-row"><span>1–2 weeks</span><span class="amt">$55</span></div><div class="price-row"><span>2–3 weeks</span><span class="amt">$60</span></div></div>
  </div>
  <div class="note-strip reveal">
    <div><b>$30</b>House Call Add-On</div>
    <div><b>$15</b>Non-Refundable Deposit</div>
